# The Makerie — app environment
# Copy to .env.local (git-ignored). Only *publishable* values belong here:
# they are bundled into the browser. Never add a secret / service-role key.

# Local development: run `npm run db:start`, then copy the API URL and
# publishable key it prints.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical origin for OAuth redirects. Locally http://localhost:3000;
# in Vercel Production https://themakerie.vercel.app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
