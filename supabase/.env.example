# Local Supabase (CLI) secrets — copy to supabase/.env (git-ignored).
# Used by supabase/config.toml via env(...) substitution. Never commit values.

# Google OAuth client (a *development* client whose authorized redirect URI
# is http://127.0.0.1:56321/auth/v1/callback).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
